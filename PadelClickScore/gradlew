#!/usr/bin/env sh
set -eu
GRADLE_VERSION=8.9
GRADLE_HOME_DIR="${HOME}/.gradle/padel-bootstrap/gradle-${GRADLE_VERSION}"
DIST_ZIP="${HOME}/.gradle/padel-bootstrap/gradle-${GRADLE_VERSION}-bin.zip"
DIST_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
if [ ! -x "$GRADLE_HOME_DIR/bin/gradle" ]; then
  mkdir -p "$(dirname "$DIST_ZIP")"
  echo "Downloading Gradle ${GRADLE_VERSION}..."
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$DIST_URL" -o "$DIST_ZIP"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$DIST_ZIP" "$DIST_URL"
  else
    echo "Error: curl or wget is required to bootstrap Gradle." >&2
    exit 1
  fi
  rm -rf "$GRADLE_HOME_DIR"
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$DIST_ZIP" -d "$(dirname "$GRADLE_HOME_DIR")"
  else
    echo "Error: unzip is required to bootstrap Gradle." >&2
    exit 1
  fi
fi
exec "$GRADLE_HOME_DIR/bin/gradle" "$@"
